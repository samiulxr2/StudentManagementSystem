<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sms.controller.CourseController"
            style="-fx-background-color:#071923;">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-background-color:#0A202C;
                     -fx-padding:18 24 18 24;
                     -fx-border-color:#183B49;
                     -fx-border-width:0 0 1 0;">

            <Label text="Course Management"
                   style="-fx-font-size:28px;
                          -fx-font-weight:bold;
                          -fx-text-fill:#D8F0F4;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField"
                       promptText="Search by Code or Name..."
                       prefWidth="325"
                       style="-fx-background-color:#102A36;
                              -fx-control-inner-background:#102A36;
                              -fx-text-fill:#E5F7FA;
                              -fx-prompt-text-fill:#6D8B98;
                              -fx-border-color:#245363;
                              -fx-border-width:1;
                              -fx-border-radius:10;
                              -fx-background-radius:10;
                              -fx-padding:9 14;
                              -fx-font-size:13px;"/>

            <Button text="Search"
                    onAction="#searchCourse"
                    style="-fx-background-color:#18AEB5;
                           -fx-text-fill:white;
                           -fx-font-size:13px;
                           -fx-font-weight:bold;
                           -fx-background-radius:9;
                           -fx-padding:10 20;
                           -fx-cursor:hand;"/>

            <Button text="Refresh"
                    onAction="#refreshTable"
                    style="-fx-background-color:#143440;
                           -fx-text-fill:#BFE1E6;
                           -fx-font-size:13px;
                           -fx-font-weight:bold;
                           -fx-border-color:#245363;
                           -fx-border-width:1;
                           -fx-border-radius:9;
                           -fx-background-radius:9;
                           -fx-padding:10 20;
                           -fx-cursor:hand;"/>

        </HBox>
    </top>


    <!-- MAIN CONTENT -->
    <center>

        <VBox spacing="20"
              style="-fx-background-color:#071923;">

            <padding>
                <Insets top="24"
                        right="24"
                        bottom="24"
                        left="24"/>
            </padding>


            <!-- COURSE INFORMATION CARD -->

            <VBox spacing="15"
                  style="-fx-background-color:#0D2531;
                         -fx-background-radius:16;
                         -fx-border-color:#1C4655;
                         -fx-border-width:1;
                         -fx-border-radius:16;
                         -fx-padding:24;">

                <Label text="Course Information"
                       style="-fx-font-size:20px;
                              -fx-font-weight:bold;
                              -fx-text-fill:#CDE8ED;"/>


                <GridPane hgap="15"
                          vgap="15">

                    <columnConstraints>

                        <ColumnConstraints percentWidth="18"/>

                        <ColumnConstraints percentWidth="32"/>

                        <ColumnConstraints percentWidth="18"/>

                        <ColumnConstraints percentWidth="32"/>

                    </columnConstraints>


                    <!-- COURSE CODE -->

                    <Label text="Course Code"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"
                           style="-fx-text-fill:#AFCBD2;
                                  -fx-font-size:13px;
                                  -fx-font-weight:bold;"/>

                    <TextField fx:id="courseCodeField"
                               promptText="Example: CSE222"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"
                               style="-fx-background-color:#102A36;
                                      -fx-control-inner-background:#102A36;
                                      -fx-text-fill:#E5F7FA;
                                      -fx-prompt-text-fill:#62808C;
                                      -fx-border-color:#245363;
                                      -fx-border-width:1;
                                      -fx-border-radius:9;
                                      -fx-background-radius:9;
                                      -fx-padding:10 13;
                                      -fx-font-size:13px;"/>


                    <!-- COURSE NAME -->

                    <Label text="Course Name"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="2"
                           style="-fx-text-fill:#AFCBD2;
                                  -fx-font-size:13px;
                                  -fx-font-weight:bold;"/>

                    <TextField fx:id="courseNameField"
                               promptText="Enter Course Name"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="3"
                               style="-fx-background-color:#102A36;
                                      -fx-control-inner-background:#102A36;
                                      -fx-text-fill:#E5F7FA;
                                      -fx-prompt-text-fill:#62808C;
                                      -fx-border-color:#245363;
                                      -fx-border-width:1;
                                      -fx-border-radius:9;
                                      -fx-background-radius:9;
                                      -fx-padding:10 13;
                                      -fx-font-size:13px;"/>


                    <!-- CREDIT -->

                    <Label text="Credit"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"
                           style="-fx-text-fill:#AFCBD2;
                                  -fx-font-size:13px;
                                  -fx-font-weight:bold;"/>

                    <TextField fx:id="creditField"
                               promptText="Example: 3.0 or 1.5"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"
                               style="-fx-background-color:#102A36;
                                      -fx-control-inner-background:#102A36;
                                      -fx-text-fill:#E5F7FA;
                                      -fx-prompt-text-fill:#62808C;
                                      -fx-border-color:#245363;
                                      -fx-border-width:1;
                                      -fx-border-radius:9;
                                      -fx-background-radius:9;
                                      -fx-padding:10 13;
                                      -fx-font-size:13px;"/>


                    <!-- COURSE TYPE -->

                    <Label text="Course Type"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="2"
                           style="-fx-text-fill:#AFCBD2;
                                  -fx-font-size:13px;
                                  -fx-font-weight:bold;"/>

                    <ComboBox fx:id="courseTypeBox"
                              promptText="Select Type"
                              prefWidth="220"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="3"
                              style="-fx-background-color:#102A36;
                                     -fx-border-color:#245363;
                                     -fx-border-width:1;
                                     -fx-border-radius:9;
                                     -fx-background-radius:9;
                                     -fx-font-size:13px;"/>


                    <!-- TEACHER ID -->

                    <Label text="Teacher ID"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"
                           style="-fx-text-fill:#AFCBD2;
                                  -fx-font-size:13px;
                                  -fx-font-weight:bold;"/>

                    <TextField fx:id="teacherIdField"
                               promptText="Example: T001"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"
                               style="-fx-background-color:#102A36;
                                      -fx-control-inner-background:#102A36;
                                      -fx-text-fill:#E5F7FA;
                                      -fx-prompt-text-fill:#62808C;
                                      -fx-border-color:#245363;
                                      -fx-border-width:1;
                                      -fx-border-radius:9;
                                      -fx-background-radius:9;
                                      -fx-padding:10 13;
                                      -fx-font-size:13px;"/>


                    <!-- SEMESTER -->

                    <Label text="Semester"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="2"
                           style="-fx-text-fill:#AFCBD2;
                                  -fx-font-size:13px;
                                  -fx-font-weight:bold;"/>

                    <TextField fx:id="semesterField"
                               promptText="Example: Fall-2026"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="3"
                               style="-fx-background-color:#102A36;
                                      -fx-control-inner-background:#102A36;
                                      -fx-text-fill:#E5F7FA;
                                      -fx-prompt-text-fill:#62808C;
                                      -fx-border-color:#245363;
                                      -fx-border-width:1;
                                      -fx-border-radius:9;
                                      -fx-background-radius:9;
                                      -fx-padding:10 13;
                                      -fx-font-size:13px;"/>

                </GridPane>


                <!-- BUTTONS -->

                <HBox spacing="12">

                    <Button text="Add"
                            onAction="#addCourse"
                            style="-fx-background-color:#18AEB5;
                                   -fx-text-fill:white;
                                   -fx-font-size:13px;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:9;
                                   -fx-padding:10 20;
                                   -fx-cursor:hand;"/>

                    <Button text="Update"
                            onAction="#updateCourse"
                            style="-fx-background-color:#18AEB5;
                                   -fx-text-fill:white;
                                   -fx-font-size:13px;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:9;
                                   -fx-padding:10 20;
                                   -fx-cursor:hand;"/>

                    <Button text="Delete"
                            onAction="#deleteCourse"
                            style="-fx-background-color:#B9363E;
                                   -fx-text-fill:white;
                                   -fx-font-size:13px;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:9;
                                   -fx-padding:10 20;
                                   -fx-cursor:hand;"/>

                    <Button text="Clear"
                            onAction="#clearFields"
                            style="-fx-background-color:#143440;
                                   -fx-text-fill:#BFE1E6;
                                   -fx-font-size:13px;
                                   -fx-font-weight:bold;
                                   -fx-border-color:#245363;
                                   -fx-border-width:1;
                                   -fx-border-radius:9;
                                   -fx-background-radius:9;
                                   -fx-padding:10 20;
                                   -fx-cursor:hand;"/>

                </HBox>

            </VBox>


            <!-- TABLE HEADER -->

            <HBox alignment="CENTER_LEFT"
                  spacing="10">

                <Label text="Courses"
                       style="-fx-font-size:20px;
                              -fx-font-weight:bold;
                              -fx-text-fill:#D8F0F4;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Scroll inside the table to view more courses."
                       style="-fx-text-fill:#66828E;
                              -fx-font-size:13px;"/>

            </HBox>


            <!-- COURSE TABLE -->

            <TableView fx:id="courseTable"
                       prefHeight="500"
                       minHeight="450"
                       maxHeight="500"
                       style="-fx-background-color:#0A202B;
                              -fx-control-inner-background:#0A202B;
                              -fx-background-radius:14;
                              -fx-border-color:#1B4655;
                              -fx-border-width:1;
                              -fx-border-radius:14;
                              -fx-padding:0;">

                <columns>

                    <TableColumn fx:id="codeColumn"
                                 text="Course Code"
                                 prefWidth="140"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Course Name"
                                 prefWidth="260"/>

                    <TableColumn fx:id="creditColumn"
                                 text="Credit"
                                 prefWidth="100"/>

                    <TableColumn fx:id="typeColumn"
                                 text="Type"
                                 prefWidth="120"/>

                    <TableColumn fx:id="teacherColumn"
                                 text="Teacher ID"
                                 prefWidth="150"/>

                    <TableColumn fx:id="semesterColumn"
                                 text="Semester"
                                 prefWidth="150"/>

                </columns>

            </TableView>


            <Region minHeight="30"/>

        </VBox>

    </center>

</BorderPane>