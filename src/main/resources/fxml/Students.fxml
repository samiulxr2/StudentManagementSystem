<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sms.controller.StudentController">


    <!-- =========================================================
         TOP BAR
         ========================================================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="18"
              styleClass="module-topbar">

            <padding>
                <Insets top="18"
                        right="26"
                        bottom="18"
                        left="26"/>
            </padding>


            <!-- Page heading -->

            <VBox spacing="3">

                <Label text="Student Management"
                       styleClass="module-title"/>

                <Label text="Manage student admission and academic information"
                       styleClass="module-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <!-- Search -->

            <HBox spacing="8"
                  alignment="CENTER_RIGHT">

                <TextField fx:id="searchField"
                           promptText="Search by ID or Name..."
                           prefWidth="270"
                           prefHeight="40"
                           styleClass="module-search"/>

                <Button text="Search"
                        onAction="#searchStudent"
                        prefHeight="40"
                        styleClass="search-button"/>

                <Button text="Refresh"
                        onAction="#refreshTable"
                        prefHeight="40"
                        styleClass="secondary-button"/>

            </HBox>

        </HBox>

    </top>


    <!-- =========================================================
         CENTER
         ========================================================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="true"
                    styleClass="module-scroll">

            <content>

                <VBox spacing="22"
                      styleClass="module-background">

                    <padding>
                        <Insets top="24"
                                right="28"
                                bottom="30"
                                left="28"/>
                    </padding>


                    <!-- =================================================
                         STUDENT FORM CARD
                         ================================================= -->

                    <VBox spacing="18"
                          styleClass="form-card">


                        <!-- Form Header -->

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="4">

                                <Label text="Student Information"
                                       styleClass="form-title"/>

                                <Label text="Enter or update student details"
                                       styleClass="form-subtitle"/>

                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="ADMISSION"
                                   styleClass="form-badge"/>

                        </HBox>


                        <!-- Divider -->

                        <Region prefHeight="1"
                                styleClass="form-divider"/>


                        <!-- =================================================
                             FORM GRID
                             ================================================= -->

                        <GridPane hgap="18"
                                  vgap="14">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="15"/>

                                <ColumnConstraints percentWidth="35"/>

                                <ColumnConstraints percentWidth="15"/>

                                <ColumnConstraints percentWidth="35"/>

                            </columnConstraints>


                            <!-- =============================================
                                 STUDENT ID
                                 ============================================= -->

                            <Label text="Student ID"
                                   styleClass="field-label"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="studentIdField"
                                       promptText="Example: 251-15-500"
                                       prefHeight="42"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="1"/>


                            <!-- =============================================
                                 FULL NAME
                                 ============================================= -->

                            <Label text="Full Name"
                                   styleClass="field-label"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="2"/>

                            <TextField fx:id="nameField"
                                       promptText="Enter student's full name"
                                       prefHeight="42"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="3"/>


                            <!-- =============================================
                                 DEPARTMENT
                                 ============================================= -->

                            <Label text="Department"
                                   styleClass="field-label"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="departmentField"
                                       promptText="Example: CSE"
                                       prefHeight="42"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="1"/>


                            <!-- =============================================
                                 GENDER
                                 ============================================= -->

                            <Label text="Gender"
                                   styleClass="field-label"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="2"/>

                            <ComboBox fx:id="genderBox"
                                      promptText="Select Gender"
                                      prefHeight="42"
                                      maxWidth="Infinity"
                                      GridPane.rowIndex="1"
                                      GridPane.columnIndex="3"/>


                            <!-- =============================================
                                 EMAIL
                                 ============================================= -->

                            <Label text="Email"
                                   styleClass="field-label"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="emailField"
                                       promptText="student@example.com"
                                       prefHeight="42"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="1"/>


                            <!-- =============================================
                                 PHONE
                                 ============================================= -->

                            <Label text="Phone"
                                   styleClass="field-label"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="2"/>

                            <TextField fx:id="phoneField"
                                       promptText="Enter phone number"
                                       prefHeight="42"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="3"/>


                            <!-- =============================================
                                 ADDRESS
                                 ============================================= -->

                            <Label text="Address"
                                   styleClass="field-label"
                                   GridPane.rowIndex="3"
                                   GridPane.columnIndex="0"/>

                            <TextArea fx:id="addressField"
                                      promptText="Enter student's address"
                                      prefRowCount="2"
                                      wrapText="true"
                                      GridPane.rowIndex="3"
                                      GridPane.columnIndex="1"
                                      GridPane.columnSpan="3"/>

                        </GridPane>


                        <!-- =================================================
                             ACTION BUTTONS
                             ================================================= -->

                        <HBox spacing="10"
                              alignment="CENTER_LEFT">

                            <Button text="Add Student"
                                    onAction="#addStudent"
                                    prefHeight="42"
                                    styleClass="primary-action-button"/>

                            <Button text="Update"
                                    onAction="#updateStudent"
                                    prefHeight="42"
                                    styleClass="secondary-action-button"/>

                            <Button text="Delete"
                                    onAction="#deleteStudent"
                                    prefHeight="42"
                                    styleClass="danger-button"/>

                            <Button text="Clear"
                                    onAction="#clearFields"
                                    prefHeight="42"
                                    styleClass="secondary-action-button"/>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         TABLE HEADER
                         ================================================= -->

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="4">

                            <Label text="Registered Students"
                                   styleClass="section-title"/>

                            <Label text="Select a student from the table to edit or delete their information."
                                   styleClass="section-description"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox alignment="CENTER_RIGHT"
                              spacing="3">

                            <Label text="STUDENT RECORDS"
                                   styleClass="table-meta-title"/>

                            <Label text="Scroll inside the table"
                                   styleClass="table-meta-text"/>

                        </VBox>

                    </HBox>


                    <!-- =================================================
                         TABLE CARD
                         ================================================= -->

                    <VBox styleClass="table-card">


                        <!-- Table -->

                        <TableView fx:id="studentTable"
                                   prefHeight="520"
                                   minHeight="520"
                                   maxHeight="520"
                                   VBox.vgrow="NEVER">

                            <columns>

                                <TableColumn fx:id="idColumn"
                                             text="Student ID"
                                             prefWidth="145"/>

                                <TableColumn fx:id="nameColumn"
                                             text="Full Name"
                                             prefWidth="230"/>

                                <TableColumn fx:id="departmentColumn"
                                             text="Department"
                                             prefWidth="140"/>

                                <TableColumn fx:id="genderColumn"
                                             text="Gender"
                                             prefWidth="100"/>

                                <TableColumn fx:id="emailColumn"
                                             text="Email"
                                             prefWidth="240"/>

                                <TableColumn fx:id="phoneColumn"
                                             text="Phone"
                                             prefWidth="160"/>

                                <TableColumn fx:id="addressColumn"
                                             text="Address"
                                             prefWidth="280"/>

                            </columns>

                        </TableView>


                        <!-- Bottom table information -->

                        <HBox alignment="CENTER_LEFT"
                              spacing="10"
                              styleClass="table-footer">

                            <Label text="Student records"
                                   styleClass="table-footer-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="Use the vertical scrollbar to browse all records"
                                   styleClass="table-footer-text"/>

                        </HBox>

                    </VBox>


                    <Region minHeight="15"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>