<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sms.controller.RegistrationController"
            style="-fx-background-color:#071923;">

    <!-- ========================================================= -->
    <!-- TOP BAR -->
    <!-- ========================================================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-background-color:#0A202C;
                     -fx-padding:18 24 18 24;
                     -fx-border-color:#183B49;
                     -fx-border-width:0 0 1 0;">

            <Label text="Student Registration"
                   style="-fx-font-size:28px;
                          -fx-font-weight:bold;
                          -fx-text-fill:#D8F0F4;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField"
                       promptText="Search Student..."
                       prefWidth="280"
                       style="-fx-background-color:#102A36;
                              -fx-control-inner-background:#102A36;
                              -fx-text-fill:#E5F7FA;
                              -fx-prompt-text-fill:#668692;
                              -fx-border-color:#245363;
                              -fx-border-width:1;
                              -fx-border-radius:10;
                              -fx-background-radius:10;
                              -fx-padding:10 14;
                              -fx-font-size:13px;"/>

            <Button text="Search"
                    onAction="#searchRegistration"
                    style="-fx-background-color:#18AEB5;
                           -fx-text-fill:white;
                           -fx-font-size:13px;
                           -fx-font-weight:bold;
                           -fx-background-radius:9;
                           -fx-padding:10 20;
                           -fx-cursor:hand;"/>

            <Button text="Refresh"
                    onAction="#refreshTable"
                    style="-fx-background-color:#143440;
                           -fx-text-fill:#C7E3E8;
                           -fx-font-size:13px;
                           -fx-font-weight:bold;
                           -fx-border-color:#245363;
                           -fx-border-width:1;
                           -fx-border-radius:9;
                           -fx-background-radius:9;
                           -fx-padding:10 20;
                           -fx-cursor:hand;"/>

        </HBox>

    </top>


    <!-- ========================================================= -->
    <!-- CENTER -->
    <!-- ========================================================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    style="-fx-background-color:#071923;
                           -fx-background:#071923;
                           -fx-border-color:transparent;">

            <content>

                <VBox spacing="20"
                      fillWidth="true"
                      style="-fx-background-color:#071923;">

                    <padding>
                        <Insets top="24"
                                right="24"
                                bottom="30"
                                left="24"/>
                    </padding>


                    <!-- ================================================= -->
                    <!-- REGISTRATION FORM -->
                    <!-- ================================================= -->

                    <VBox spacing="18"
                          style="-fx-background-color:#0D2531;
                                 -fx-background-radius:16;
                                 -fx-border-color:#1C4655;
                                 -fx-border-width:1;
                                 -fx-border-radius:16;
                                 -fx-padding:24;">

                        <Label text="Semester Registration"
                               style="-fx-font-size:21px;
                                      -fx-font-weight:bold;
                                      -fx-text-fill:#CDE8ED;"/>


                        <GridPane hgap="16"
                                  vgap="16">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="18"/>

                                <ColumnConstraints percentWidth="32"/>

                                <ColumnConstraints percentWidth="18"/>

                                <ColumnConstraints percentWidth="32"/>

                            </columnConstraints>


                            <!-- STUDENT ID -->

                            <Label text="Student ID"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"
                                   style="-fx-text-fill:#AFCBD2;
                                          -fx-font-size:13px;
                                          -fx-font-weight:bold;"/>

                            <TextField fx:id="studentIdField"
                                       promptText="Example: 68-01-001"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="1"
                                       style="-fx-background-color:#102A36;
                                              -fx-control-inner-background:#102A36;
                                              -fx-text-fill:#E5F7FA;
                                              -fx-prompt-text-fill:#62808C;
                                              -fx-border-color:#245363;
                                              -fx-border-width:1;
                                              -fx-border-radius:9;
                                              -fx-background-radius:9;
                                              -fx-padding:10 13;
                                              -fx-font-size:13px;"/>


                            <!-- SEMESTER -->

                            <Label text="Semester"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="2"
                                   style="-fx-text-fill:#AFCBD2;
                                          -fx-font-size:13px;
                                          -fx-font-weight:bold;"/>

                            <ComboBox fx:id="semesterBox"
                                      promptText="Select Semester"
                                      prefWidth="220"
                                      GridPane.rowIndex="0"
                                      GridPane.columnIndex="3"
                                      style="-fx-background-color:#102A36;
                                             -fx-border-color:#245363;
                                             -fx-border-width:1;
                                             -fx-border-radius:9;
                                             -fx-background-radius:9;
                                             -fx-font-size:13px;"/>


                            <!-- BATCH -->

                            <Label text="Batch"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="0"
                                   style="-fx-text-fill:#AFCBD2;
                                          -fx-font-size:13px;
                                          -fx-font-weight:bold;"/>

                            <ComboBox fx:id="batchBox"
                                      promptText="Select Batch"
                                      prefWidth="220"
                                      GridPane.rowIndex="1"
                                      GridPane.columnIndex="1"
                                      style="-fx-background-color:#102A36;
                                             -fx-border-color:#245363;
                                             -fx-border-width:1;
                                             -fx-border-radius:9;
                                             -fx-background-radius:9;
                                             -fx-font-size:13px;"/>


                            <!-- SECTION -->

                            <Label text="Section"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="2"
                                   style="-fx-text-fill:#AFCBD2;
                                          -fx-font-size:13px;
                                          -fx-font-weight:bold;"/>

                            <ComboBox fx:id="sectionBox"
                                      promptText="Select Section"
                                      prefWidth="220"
                                      GridPane.rowIndex="1"
                                      GridPane.columnIndex="3"
                                      style="-fx-background-color:#102A36;
                                             -fx-border-color:#245363;
                                             -fx-border-width:1;
                                             -fx-border-radius:9;
                                             -fx-background-radius:9;
                                             -fx-font-size:13px;"/>


                            <!-- COURSE -->

                            <Label text="Course"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="0"
                                   style="-fx-text-fill:#AFCBD2;
                                          -fx-font-size:13px;
                                          -fx-font-weight:bold;"/>

                            <ComboBox fx:id="courseBox"
                                      promptText="Select Course"
                                      prefWidth="220"
                                      GridPane.rowIndex="2"
                                      GridPane.columnIndex="1"
                                      style="-fx-background-color:#102A36;
                                             -fx-border-color:#245363;
                                             -fx-border-width:1;
                                             -fx-border-radius:9;
                                             -fx-background-radius:9;
                                             -fx-font-size:13px;"/>


                            <!-- REGISTRATION TYPE -->

                            <Label text="Registration Type"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="2"
                                   style="-fx-text-fill:#AFCBD2;
                                          -fx-font-size:13px;
                                          -fx-font-weight:bold;"/>

                            <ComboBox fx:id="registrationTypeBox"
                                      promptText="Normal / Retake"
                                      prefWidth="220"
                                      GridPane.rowIndex="2"
                                      GridPane.columnIndex="3"
                                      style="-fx-background-color:#102A36;
                                             -fx-border-color:#245363;
                                             -fx-border-width:1;
                                             -fx-border-radius:9;
                                             -fx-background-radius:9;
                                             -fx-font-size:13px;"/>

                        </GridPane>


                        <!-- ================================================= -->
                        <!-- LAB + CAPACITY -->
                        <!-- ================================================= -->

                        <HBox spacing="12"
                              alignment="CENTER_LEFT">

                            <Label text="Lab Group:"
                                   style="-fx-text-fill:#AFCBD2;
                                          -fx-font-weight:bold;"/>

                            <Label fx:id="labSectionLabel"
                                   text="Not Applicable"
                                   style="-fx-text-fill:#D8F0F4;
                                          -fx-font-size:15px;
                                          -fx-font-weight:bold;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="Section Capacity:"
                                   style="-fx-text-fill:#AFCBD2;
                                          -fx-font-weight:bold;"/>

                            <Label fx:id="capacityLabel"
                                   text="0 / 50"
                                   style="-fx-text-fill:#8FB9C4;
                                          -fx-font-size:13px;"/>

                        </HBox>


                        <!-- ================================================= -->
                        <!-- BUTTONS -->
                        <!-- ================================================= -->

                        <HBox spacing="12">

                            <Button text="Register Student"
                                    onAction="#registerStudent"
                                    style="-fx-background-color:#18AEB5;
                                           -fx-text-fill:white;
                                           -fx-font-size:13px;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:9;
                                           -fx-padding:10 20;
                                           -fx-cursor:hand;"/>

                            <Button text="Remove Registration"
                                    onAction="#removeRegistration"
                                    style="-fx-background-color:#B9363E;
                                           -fx-text-fill:white;
                                           -fx-font-size:13px;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:9;
                                           -fx-padding:10 20;
                                           -fx-cursor:hand;"/>

                            <Button text="Clear"
                                    onAction="#clearFields"
                                    style="-fx-background-color:#143440;
                                           -fx-text-fill:#C7E3E8;
                                           -fx-font-size:13px;
                                           -fx-font-weight:bold;
                                           -fx-border-color:#245363;
                                           -fx-border-width:1;
                                           -fx-border-radius:9;
                                           -fx-background-radius:9;
                                           -fx-padding:10 20;
                                           -fx-cursor:hand;"/>

                        </HBox>

                    </VBox>


                    <!-- ================================================= -->
                    <!-- SUMMARY CARDS -->
                    <!-- ================================================= -->

                    <HBox spacing="18">

                        <!-- TOTAL -->

                        <VBox alignment="CENTER"
                              prefWidth="210"
                              prefHeight="105"
                              style="-fx-background-color:#0D2531;
                                     -fx-background-radius:14;
                                     -fx-border-color:#1C4655;
                                     -fx-border-width:1;
                                     -fx-border-radius:14;
                                     -fx-padding:15;">

                            <Label text="Total Registrations"
                                   style="-fx-text-fill:#8FB9C4;
                                          -fx-font-size:13px;
                                          -fx-font-weight:bold;"/>

                            <Label fx:id="totalRegistrationLabel"
                                   text="0"
                                   style="-fx-text-fill:#D8F0F4;
                                          -fx-font-size:26px;
                                          -fx-font-weight:bold;"/>

                        </VBox>


                        <!-- THEORY -->

                        <VBox alignment="CENTER"
                              prefWidth="210"
                              prefHeight="105"
                              style="-fx-background-color:#0D2531;
                                     -fx-background-radius:14;
                                     -fx-border-color:#1C4655;
                                     -fx-border-width:1;
                                     -fx-border-radius:14;
                                     -fx-padding:15;">

                            <Label text="Theory Section"
                                   style="-fx-text-fill:#8FB9C4;
                                          -fx-font-size:13px;
                                          -fx-font-weight:bold;"/>

                            <Label fx:id="sectionCountLabel"
                                   text="0 / 50"
                                   style="-fx-text-fill:#D8F0F4;
                                          -fx-font-size:23px;
                                          -fx-font-weight:bold;"/>

                        </VBox>


                        <!-- LAB -->

                        <VBox alignment="CENTER"
                              prefWidth="210"
                              prefHeight="105"
                              style="-fx-background-color:#0D2531;
                                     -fx-background-radius:14;
                                     -fx-border-color:#1C4655;
                                     -fx-border-width:1;
                                     -fx-border-radius:14;
                                     -fx-padding:15;">

                            <Label text="Lab Group"
                                   style="-fx-text-fill:#8FB9C4;
                                          -fx-font-size:13px;
                                          -fx-font-weight:bold;"/>

                            <Label fx:id="labCountLabel"
                                   text="N/A"
                                   style="-fx-text-fill:#D8F0F4;
                                          -fx-font-size:23px;
                                          -fx-font-weight:bold;"/>

                        </VBox>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- REGISTRATION TABLE -->
                    <!-- ================================================= -->

                    <VBox spacing="12"
                          VBox.vgrow="ALWAYS"
                          style="-fx-background-color:#0D2531;
                                 -fx-background-radius:16;
                                 -fx-border-color:#1C4655;
                                 -fx-border-width:1;
                                 -fx-border-radius:16;
                                 -fx-padding:20;">

                        <HBox alignment="CENTER_LEFT">

                            <Label text="Registered Students"
                                   style="-fx-font-size:20px;
                                          -fx-font-weight:bold;
                                          -fx-text-fill:#D8F0F4;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="Retake registrations are marked separately"
                                   style="-fx-text-fill:#6F919B;
                                          -fx-font-size:12px;"/>

                        </HBox>


                        <TableView fx:id="registrationTable"
                                   VBox.vgrow="ALWAYS"
                                   prefHeight="500"
                                   minHeight="420"
                                   style="-fx-background-color:#0A202B;
                                          -fx-control-inner-background:#0A202B;
                                          -fx-background-radius:12;
                                          -fx-border-color:#1B4655;
                                          -fx-border-width:1;
                                          -fx-border-radius:12;">

                            <columns>

                                <TableColumn fx:id="registrationIdColumn"
                                             text="Registration ID"
                                             prefWidth="150"/>

                                <TableColumn fx:id="studentIdColumn"
                                             text="Student ID"
                                             prefWidth="150"/>

                                <TableColumn fx:id="studentNameColumn"
                                             text="Student Name"
                                             prefWidth="220"/>

                                <TableColumn fx:id="semesterColumn"
                                             text="Semester"
                                             prefWidth="130"/>

                                <TableColumn fx:id="batchColumn"
                                             text="Batch"
                                             prefWidth="100"/>

                                <TableColumn fx:id="sectionColumn"
                                             text="Section"
                                             prefWidth="100"/>

                                <TableColumn fx:id="labSectionColumn"
                                             text="Lab Group"
                                             prefWidth="110"/>

                                <TableColumn fx:id="courseCodeColumn"
                                             text="Course"
                                             prefWidth="130"/>

                                <TableColumn fx:id="retakeColumn"
                                             text="Retake"
                                             prefWidth="90"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <Region minHeight="30"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>