<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sms.controller.DashboardController"
            styleClass="dashboard-root">

    <!-- =========================================================
         LEFT SIDEBAR
         ========================================================= -->

    <left>

        <VBox prefWidth="270"
              minWidth="270"
              maxWidth="270"
              spacing="8"
              styleClass="sidebar">

            <padding>
                <Insets top="20"
                        right="18"
                        bottom="20"
                        left="18"/>
            </padding>


            <!-- =================================================
                 BRANDING
                 ================================================= -->

            <VBox spacing="10"
                  alignment="CENTER"
                  styleClass="brand-container">

                <!-- =================================================
                     APPLICATION LOGO
                     ================================================= -->

                <StackPane prefWidth="82"
                           prefHeight="82"
                           maxWidth="82"
                           maxHeight="82"
                           alignment="CENTER"
                           styleClass="app-logo">

                    <ImageView fitWidth="78"
                               fitHeight="78"
                               preserveRatio="true"
                               smooth="true"
                               pickOnBounds="true">

                        <image>
                            <Image url="@../images/sms-logo.png"/>
                        </image>

                    </ImageView>

                </StackPane>


                <!-- =================================================
                     APPLICATION NAME
                     ================================================= -->

                <Label text="ACADEMIC ADMINISTRATION"
                       styleClass="sidebar-section-title"/>

            </VBox>


            <Separator/>


            <!-- =================================================
                 NAVIGATION
                 ================================================= -->

            <VBox spacing="6"
                  styleClass="navigation-container">

                <Button text="⌂   Dashboard"
                        onAction="#showDashboard"
                        styleClass="sidebar-button"/>

                <Button text="♙   Students"
                        onAction="#openStudents"
                        styleClass="sidebar-button"/>

                <Button text="♙   Teachers"
                        onAction="#openTeachers"
                        styleClass="sidebar-button"/>

                <Button text="▣   Courses"
                        onAction="#openCourses"
                        styleClass="sidebar-button"/>

                <Button text="▤   Registration"
                        onAction="#openRegistration"
                        styleClass="sidebar-button"/>

                <Button text="▦   Attendance"
                        onAction="#openAttendance"
                        styleClass="sidebar-button"/>

                <Button text="▤   Results"
                        onAction="#openResults"
                        styleClass="sidebar-button"/>

                <Button text="⚙   Settings"
                        onAction="#openSettings"
                        styleClass="sidebar-button"/>

            </VBox>


            <!-- =================================================
                 FLEXIBLE SPACE
                 ================================================= -->

            <Region VBox.vgrow="ALWAYS"/>


            <!-- =================================================
                 SYSTEM STATUS
                 ================================================= -->

            <VBox spacing="8"
                  styleClass="system-status">

                <Separator/>

                <Label text="SYSTEM STATUS"
                       styleClass="status-title"/>

                <HBox spacing="8"
                      alignment="CENTER_LEFT">

                    <Label text="●"
                           styleClass="online-dot"/>

                    <Label text="System Online"
                           styleClass="online-text"/>

                </HBox>

            </VBox>


            <!-- =================================================
                 LOGOUT
                 ================================================= -->

            <Button text="↪   Logout"
                    onAction="#logout"
                    styleClass="logout-button"/>

        </VBox>

    </left>


    <!-- =========================================================
         TOP BAR
         ========================================================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="topbar">

            <padding>
                <Insets top="17"
                        right="28"
                        bottom="17"
                        left="28"/>
            </padding>


            <!-- PAGE TITLE -->

            <VBox spacing="3">

                <Label fx:id="pageTitleLabel"
                       text="Dashboard"
                       styleClass="page-title"/>

                <Label fx:id="pageSubtitleLabel"
                       text="Academic Management Overview"
                       styleClass="page-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <!-- USER INFORMATION -->

            <VBox alignment="CENTER_RIGHT"
                  spacing="3">

                <Label fx:id="welcomeLabel"
                       styleClass="welcome-text"/>

                <Label text="Administrator"
                       styleClass="welcome-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =========================================================
         CENTER
         ========================================================= -->

    <center>

        <StackPane styleClass="content-background">

            <!-- =================================================
                 MAIN SCROLL CONTAINER
                 ================================================= -->

            <ScrollPane fx:id="mainScrollPane"
                        fitToWidth="true"
                        fitToHeight="false"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="main-scroll">

                <VBox spacing="20"
                      styleClass="dashboard-content">

                    <padding>
                        <Insets top="25"
                                right="28"
                                bottom="35"
                                left="28"/>
                    </padding>


                    <!-- =================================================
                         DASHBOARD HOME
                         ================================================= -->

                    <VBox fx:id="dashboardPane"
                          spacing="22">


                        <!-- =================================================
                             STAT CARDS
                             ================================================= -->

                        <HBox spacing="18"
                              fillHeight="true">

                            <VBox alignment="CENTER_LEFT"
                                  spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  styleClass="stat-card">

                                <Label text="STUDENTS"
                                       styleClass="stat-label"/>

                                <Label fx:id="studentCountLabel"
                                       text="0"
                                       styleClass="stat-value"/>

                                <Label text="Registered students"
                                       styleClass="stat-description"/>

                            </VBox>


                            <VBox alignment="CENTER_LEFT"
                                  spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  styleClass="stat-card">

                                <Label text="TEACHERS"
                                       styleClass="stat-label"/>

                                <Label fx:id="teacherCountLabel"
                                       text="0"
                                       styleClass="stat-value"/>

                                <Label text="Faculty members"
                                       styleClass="stat-description"/>

                            </VBox>


                            <VBox alignment="CENTER_LEFT"
                                  spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  styleClass="stat-card">

                                <Label text="COURSES"
                                       styleClass="stat-label"/>

                                <Label fx:id="courseCountLabel"
                                       text="0"
                                       styleClass="stat-value"/>

                                <Label text="Active courses"
                                       styleClass="stat-description"/>

                            </VBox>


                            <VBox alignment="CENTER_LEFT"
                                  spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  styleClass="stat-card">

                                <Label text="RESULTS"
                                       styleClass="stat-label"/>

                                <Label fx:id="resultCountLabel"
                                       text="0"
                                       styleClass="stat-value"/>

                                <Label text="Academic records"
                                       styleClass="stat-description"/>

                            </VBox>

                        </HBox>


                        <!-- =================================================
                             RECENT ACTIVITY
                             ================================================= -->

                        <VBox spacing="15"
                              styleClass="dashboard-card">

                            <HBox alignment="CENTER_LEFT">

                                <VBox spacing="3">

                                    <Label text="Recent Activity"
                                           styleClass="card-heading"/>

                                    <Label text="Latest system activities"
                                           styleClass="card-subheading"/>

                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button text="Refresh"
                                        onAction="#refreshDashboard"
                                        styleClass="secondary-button"/>

                            </HBox>


                            <ListView fx:id="activityList"
                                      prefHeight="280"
                                      styleClass="activity-list"/>

                        </VBox>

                    </VBox>


                    <!-- =================================================
                         OTHER PAGES
                         ================================================= -->

                    <StackPane fx:id="contentPane"
                               VBox.vgrow="ALWAYS"/>

                </VBox>

            </ScrollPane>

        </StackPane>

    </center>

</BorderPane>