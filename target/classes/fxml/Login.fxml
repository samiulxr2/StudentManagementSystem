<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sms.controller.LoginController">

    <center>

        <StackPane styleClass="login-background">

            <!-- =====================================================
                 MAIN LOGIN CARD
                 ===================================================== -->

            <HBox maxWidth="1100"
                  maxHeight="650"
                  prefWidth="1100"
                  prefHeight="650"
                  styleClass="login-container">


                <!-- =================================================
                     LEFT SIDE - LOGO
                     ================================================= -->

                <VBox prefWidth="470"
                      alignment="CENTER"
                      spacing="24"
                      styleClass="login-brand-panel">

                    <padding>
                        <Insets top="30"
                                right="40"
                                bottom="35"
                                left="40"/>
                    </padding>


                    <!-- =================================================
                         LARGE LOGO
                         ================================================= -->

                    <StackPane prefWidth="280"
                               prefHeight="280"
                               maxWidth="280"
                               maxHeight="280"
                               alignment="CENTER">

                        <ImageView fitWidth="270"
                                   fitHeight="270"
                                   preserveRatio="true"
                                   smooth="true"
                                   pickOnBounds="true"
                                   style="-fx-effect:dropshadow(gaussian, rgba(34,211,238,0.45), 30, 0.30, 0, 5);">

                            <image>
                                <Image url="@../images/sms-logo.png"/>
                            </image>

                        </ImageView>

                    </StackPane>


                    <!-- =================================================
                         SUPPORTING TEXT
                         ================================================= -->

                    <Label text="Academic Administration"
                           alignment="CENTER"
                           style="-fx-text-fill:#94A3B8;
                                  -fx-font-size:14px;"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <!-- =================================================
                         FOOTER
                         ================================================= -->

                    <VBox alignment="CENTER"
                          spacing="4">

                        <Label text="UNIVERSITY ADMINISTRATION"
                               styleClass="brand-footer-title"/>

                        <Label text="Academic Management Portal"
                               styleClass="brand-footer-text"/>

                    </VBox>

                </VBox>


                <!-- =================================================
                     RIGHT SIDE - LOGIN FORM
                     ================================================= -->

                <VBox prefWidth="600"
                      alignment="TOP_LEFT"
                      spacing="20"
                      styleClass="login-form-panel">

                    <padding>
                        <Insets top="65"
                                right="65"
                                bottom="55"
                                left="65"/>
                    </padding>


                    <!-- =================================================
                         SYSTEM NAME
                         ================================================= -->

                    <Label text="Student Management System"
                           wrapText="false"
                           maxWidth="500"
                           style="-fx-text-fill:white;
                                  -fx-font-size:28px;
                                  -fx-font-weight:bold;"/>


                    <!-- =================================================
                         ACCENT LINE
                         ================================================= -->

                    <Region prefWidth="75"
                            prefHeight="4"
                            maxWidth="75"
                            style="-fx-background-color:#18B8C4;
                                   -fx-background-radius:5;"/>


                    <Region prefHeight="15"/>


                    <!-- =================================================
                         USERNAME
                         ================================================= -->

                    <VBox spacing="8"
                          maxWidth="500">

                        <Label text="Username"
                               styleClass="login-label"/>

                        <TextField fx:id="usernameField"
                                   promptText="Enter your username"
                                   prefHeight="52"
                                   maxWidth="500"
                                   styleClass="login-input"/>

                    </VBox>


                    <!-- =================================================
                         PASSWORD
                         ================================================= -->

                    <VBox spacing="8"
                          maxWidth="500">

                        <Label text="Password"
                               styleClass="login-label"/>

                        <PasswordField fx:id="passwordField"
                                       promptText="Enter your password"
                                       prefHeight="52"
                                       maxWidth="500"
                                       styleClass="login-input"/>

                    </VBox>


                    <!-- =================================================
                         SIGN IN
                         ================================================= -->

                    <Button text="Sign In"
                            prefWidth="500"
                            prefHeight="54"
                            onAction="#login"
                            styleClass="login-button"/>


                    <!-- =================================================
                         MESSAGE
                         ================================================= -->

                    <Label fx:id="messageLabel"
                           text=""
                           wrapText="true"
                           maxWidth="500"
                           styleClass="login-error"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <!-- =================================================
                         FOOTER
                         ================================================= -->

                    <HBox alignment="CENTER_LEFT"
                          maxWidth="500">

                        <Label text="Version 1.0"
                               styleClass="login-footer"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Administrator"
                               styleClass="login-footer"/>

                    </HBox>

                </VBox>

            </HBox>

        </StackPane>

    </center>

</BorderPane>